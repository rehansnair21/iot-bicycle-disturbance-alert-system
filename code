// ======================================
// CHECK VIBRATION SENSOR
// ======================================
void checkVibration() {
    vibrationDetected =
        (digitalRead(vibrationPin) == ACTIVE_STATE);

    if (securityArmed && vibrationDetected) {
        unsigned long now = millis();

        if (now - lastAlertTime >= alertCooldown) {
            alertCount++;
            lastAlertTime = now;

            Serial.println(
                "WARNING: Bicycle disturbance detected!"
            );

            Serial.print("Total alerts: ");
            Serial.println(alertCount);
        }
    }
}

// ======================================
// STATUS API
// ======================================
void handleStatus() {
    String json = "{";

    json += "\"armed\":";
    json += securityArmed ? "true" : "false";

    json += ",\"vibration\":";
    json += vibrationDetected ? "true" : "false";

    json += ",\"alertCount\":";
    json += String(alertCount);

    json += ",\"lastAlert\":\"";

    if (alertCount == 0) {
        json += "None";
    } else {
        json += String(
            (millis() - lastAlertTime) / 1000
        );

        json += " seconds ago";
    }

    json += "\"}";

    server.sendHeader("Cache-Control", "no-store");

    server.send(
        200,
        "application/json",
        json
    );
}

// ======================================
// TOGGLE SECURITY
// ======================================
void handleToggle() {
    securityArmed = !securityArmed;

    Serial.print("Security status: ");

    Serial.println(
        securityArmed ? "ARMED" : "DISARMED"
    );

    server.send(
        200,
        "application/json",
        securityArmed
            ? "{\"armed\":true}"
            : "{\"armed\":false}"
    );
}

// ======================================
// SETUP
// ======================================
void setup() {
    Serial.begin(115200);

    delay(1000);

    pinMode(vibrationPin, INPUT);

    Serial.println();
    Serial.println("================================");
    Serial.println("IoT Bicycle Disturbance System");
    Serial.println("Starting Wi-Fi hotspot...");
    Serial.println("================================");

    WiFi.mode(WIFI_AP);
    WiFi.setSleep(false);

    WiFi.softAPConfig(
        localIP,
        gateway,
        subnet
    );

    bool result = WiFi.softAP(
        AP_SSID,
        AP_PASSWORD,
        6,
        false,
        4
    );

    if (result) {
        Serial.println("Wi-Fi hotspot started!");

        Serial.print("Wi-Fi Name: ");
        Serial.println(AP_SSID);

        Serial.print("Wi-Fi Password: ");
        Serial.println(AP_PASSWORD);

        Serial.print("Dashboard IP: http://");
        Serial.println(WiFi.softAPIP());

    } else {
        Serial.println("ERROR: Wi-Fi hotspot failed!");
    }

    server.on("/", HTTP_GET, []() {
        server.send_P(
            200,
            "text/html",
            dashboard
        );
    });

    server.on(
        "/api/status",
        HTTP_GET,
        handleStatus
    );

    server.on(
        "/api/toggle",
        HTTP_POST,
        handleToggle
    );

    server.begin();

    Serial.println("Web server started!");
    Serial.println("Open http://192.168.4.1");
}

// ======================================
